# ---------------------------------------------------------------------------
# Xperience Padel V2 — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs réelles.
# `.env.local` n'est jamais versionné.
# ---------------------------------------------------------------------------

# Supabase — Dashboard > Project Settings > API
# Projet : https://supabase.com/dashboard/project/diokcsiupaekwhatjsgm
NEXT_PUBLIC_SUPABASE_URL="https://diokcsiupaekwhatjsgm.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<clé publishable / anon>"

# Clé secrète — SERVEUR UNIQUEMENT, ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY="<clé secret / service_role>"

# URL publique de l'application (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys  (Lot 7, peut rester vide pour l'instant)
RESEND_API_KEY=""
EMAIL_FROM="Xperience Padel <no-reply@padelxp.be>"
