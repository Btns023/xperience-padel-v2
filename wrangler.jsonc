{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit correspondre exactement au nom du Worker créé dans Cloudflare,
  // sinon `wrangler deploy` en crée un second à côté.
  "name": "xperience-padel-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  // nodejs_compat : Next.js et le client Supabase utilisent des API Node.
  // global_fetch_strictly_public : le Worker sort par l'Internet public pour
  // atteindre son propre domaine, comportement attendu par l'adaptateur.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Publie le Worker sur <nom>.<compte>.workers.dev, l'adresse de test.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // À FAIRE — tâches planifiées.
  // Vercel appelait deux routes HTTP (voir l'ancien vercel.json) :
  //   /api/cron/reminders  tous les jours à 7h   "0 7 * * *"
  //   /api/cron/dunning    le lundi à 8h         "0 8 * * 1"
  // Chez Cloudflare, un « cron trigger » appelle un handler `scheduled` que le
  // worker généré par OpenNext n'expose pas. Les deux routes restent valables
  // et protégées par CRON_SECRET : il faut un petit worker séparé qui les
  // appelle, ou un point d'entrée personnalisé. Tant que ce n'est pas fait,
  // ni les rappels de séance ni les relances d'impayés ne partent tout seuls.
}
